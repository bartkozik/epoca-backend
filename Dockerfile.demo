FROM eclipse-temurin:17-jre-jammy@sha256:2a9eb226abb654c9d1f91b53cf638d20cb3abb726d1b18a67909c29515545469
WORKDIR /app
COPY --chown=1001:1001 target/universal/stage/lib/ ./lib/
USER 1001:1001
ENV PORT=9000 KAMON_ENABLED=false OAUTH_ENABLED=false ASSETS_STORAGE=memory
EXPOSE 9000
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=65", "-XX:ActiveProcessorCount=2", "-cp", "/app/lib/*"]
CMD ["pl.iterators.epoca.main.Main"]
